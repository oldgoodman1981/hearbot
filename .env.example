# Провайдер распознавания: dummy | yandex
STT_PROVIDER=dummy

# Язык по умолчанию (BCP-47)
STT_LANGUAGE=ru-RU

# Yandex SpeechKit (нужно для STT_PROVIDER=yandex)
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# Максимальная длина одной реплики в секундах
MAX_UTTERANCE_SECONDS=30

# Доступ к WebSocket
ALLOW_ANONYMOUS=true
# Если ALLOW_ANONYMOUS=false, клиент обязан передать ?token=...
HEARBOT_TOKEN=

# Панель управления /admin и REST API /api/*
# Если пусто — доступ без авторизации (удобно локально).
# Если задано — браузер запросит токен, а запросы должны содержать X-Admin-Token.
HEARBOT_ADMIN_TOKEN=
